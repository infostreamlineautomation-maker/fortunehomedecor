# Public website (Next.js, port 3000)
# Browser-facing API URL (prod: https://api.example.com)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side API URL used during SSR (prod on same VPS: http://127.0.0.1:8000)
API_INTERNAL_URL=http://127.0.0.1:8000
# Canonical site URL for SEO/sitemap (prod: https://example.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared with backend/.env: lets the admin API refresh cached pages after CMS edits
REVALIDATE_SECRET=
