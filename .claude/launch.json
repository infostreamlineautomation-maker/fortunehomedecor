{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "backend/venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["app.main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "admin-api",
      "runtimeExecutable": "backend/venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["app.admin_main:app", "--app-dir", "backend", "--port", "8001"],
      "port": 8001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "-p", "3000"],
      "port": 3000
    },
    {
      "name": "cms",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "cms", "run", "dev", "--", "-p", "3001"],
      "port": 3001
    }
  ]
}
