# Copy to backend/.env and fill in real values.
APP_NAME="Fortune Decor"
# development | production
APP_ENV=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fortune_decor

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Public website origin(s) -> public API (8000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CMS origin(s) -> admin API (8001)
ADMIN_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# Public website + CMS URLs (used in enquiry emails)
SITE_URL=http://localhost:3000
CMS_URL=http://localhost:3001
# After CMS edits the admin API asks the website to refresh its cache.
# Must match REVALIDATE_SECRET in frontend/.env.local. Empty = disabled.
REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
REVALIDATE_SECRET=

# Enquiry notification email (SMTP). Leave SMTP_HOST empty to disable sending.
# Hostinger mailbox example: smtp.hostinger.com, port 465, SMTP_SSL=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated addresses that receive new enquiry alerts
ENQUIRY_NOTIFY_TO=
